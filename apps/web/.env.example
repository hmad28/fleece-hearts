# Checkout/pembayaran masih simulasi; katalog, CMS, chat, akun, dan riwayat order akun memakai Neon.
NEXT_PUBLIC_DATA_SOURCE=mock

# Dipakai saat DATA_SOURCE=api
NEXT_PUBLIC_API_URL=https://api.fleeceheart.com

# URL publik storefront (untuk metadata/OG/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon CLI menaruh nilai asli di .env.local root; skrip web menyalinnya saat dev/build.
# Pada Vercel set ini sebagai server environment variables (tanpa NEXT_PUBLIC_).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
ADMIN_USER_IDS=
UPLOADTHING_TOKEN=
